msgid "Assumption Checks"
msgstr "بررسی مفروضات"

msgid "Descriptives"
msgstr "آماره‌های توصیفی"

msgid "Vovk-Sellke Maximum <em>p</em>-Ratio: Based on a two-sided <em>p</em>-value,the maximum possible odds in favor of H%1$s over H%2$s equals 1/(-e <em>p</em> log(<em>p</em>)) for <em>p</em> %3$s .37 (Sellke, Bayarri, & Berger, 2001)."
msgstr ""
"حداکثر نسبت <em>p</em> ووک-سلکه: بر اساس یک مقدار <em>p</em> دوطرفه، حداکثر "
"شانس ممکن به نفع H%1$s در برابر H%2$s برابر با 1/(-e <em>p</em> log(<em>p</"
"em>)) برای <em>p</em> %3$s .37 است (سلکه، بایاری و برگر، 2001)."

msgid "Q-Q Plots"
msgstr "نمودارهای Q-Q"

msgid "Please provide another variable."
msgstr "لطفاً متغیر دیگری ارائه دهید."

msgid "Variables %1$s and %2$s are the same!"
msgstr "متغیرهای %1$s و %2$s یکسان هستند!"

msgid "Descriptives Plots"
msgstr "نمودارهای توصیفی"

msgid "Bar Plots"
msgstr "نمودارهای میله‌ای"

msgid "Group"
msgstr "گروه"

msgid "N"
msgstr "N"

msgid "Mean"
msgstr "میانگین"

msgid "SD"
msgstr "انحراف معیار"

msgid "SE"
msgstr "خطای معیار"

msgid "Coefficient of variation"
msgstr "ضریب تغییرات"

msgid "%.0f%% Credible Interval"
msgstr "بازه باورپذیر %.0f%%"

msgid "Lower"
msgstr "پایین"

msgid "Upper"
msgstr "بالا"

msgid "Inferential Plots"
msgstr "نمودارهای استنباطی"

msgid "Prior and Posterior"
msgstr "پیشین و پسین"

msgid "Bayes Factor Robustness Check"
msgstr "بررسی استواری فاکتور بیزی"

msgid "Sequential Analysis"
msgstr "تحلیل ترتیبی"

msgid "Bayes factor robustness check plot currently not supported for informed prior."
msgstr ""
"نمودار بررسی استواری فاکتور بیزی در حال حاضر برای پیشین آگاهانه پشتیبانی "
"نمی‌شود."

msgid "Sequential analysis robustness check plot currently not supported for informed prior."
msgstr ""
"نمودار بررسی استواری تحلیل ترتیبی در حال حاضر برای پیشین آگاهانه پشتیبانی "
"نمی‌شود."

msgid "Expected numeric or character rscale but got %s."
msgstr "مقیاس r عددی یا کاراکتری انتظار می‌رفت، اما %s دریافت شد."

msgid "Running robustness check %1$d / %2$d"
msgstr "در حال اجرای بررسی استواری %1$d / %2$d"

msgid "max BF%s"
msgstr "حداکثر BF%s"

msgid "user prior"
msgstr "پیشین کاربر"

msgid "wide prior"
msgstr "پیشین پهن"

msgid "ultrawide prior"
msgstr "پیشین بسیار پهن"

msgid "BF%s"
msgstr "BF%s"

msgid "%1$s at r==%2$s"
msgstr "%1$s در r==%2$s"

msgid "Some Bayes factors were infinite"
msgstr "برخی فاکتورهای بیزی بی‌نهایت بودند"

msgid "Cauchy prior width"
msgstr "پهنای پیشین کوشی"

msgid "Running sequential analysis %1$d / %2$d"
msgstr "در حال اجرای تحلیل ترتیبی %1$d / %2$d"

msgid "n"
msgstr "n"

msgid "Posterior"
msgstr "پسین"

msgid "Prior"
msgstr "پیشین"

msgid "%s%% CI:"
msgstr "بازه اطمینان %s%%:"

msgid "Effect size"
msgstr "اندازه اثر"

msgid "Raincloud Plots"
msgstr "نمودارهای ابر بارانی"

msgid "Raincloud Difference Plots"
msgstr "نمودارهای تفاوت ابر بارانی"

msgid "Bayes factor could not be calculated"
msgstr "فاکتور بیزی قابل محاسبه نبود"

msgid "Bayes factor is infinite"
msgstr "فاکتور بیزی بی‌نهایت است"

msgid "The Bayes factor is too small"
msgstr "فاکتور بیزی بسیار کوچک است"

msgid "t-value is large. A Savage-Dickey approximation was used to compute the Bayes factor but no error estimate can be given."
msgstr ""
"مقدار t بزرگ است. یک تقریب ساوج-دیکی برای محاسبه فاکتور بیزی استفاده شد، اما "
"هیچ برآورد خطایی نمی‌تواند ارائه شود."

msgid "No error estimate is available for normal priors."
msgstr "هیچ برآورد خطایی برای پیشین‌های نرمال در دسترس نیست."

msgid "Bayesian Mann-Whitney U Test"
msgstr "آزمون U مان-ویتنی بیزی"

msgid "Bayesian Independent Samples T-Test"
msgstr "آزمون t نمونه‌های مستقل بیزی"

msgid "Result based on data augmentation algorithm with 5 chains of %.0f iterations."
msgstr "نتیجه بر اساس الگوریتم افزایش داده با ۵ زنجیره از %.0f تکرار است."

msgid "error %%"
msgstr "خطا %%"

msgid "For all tests, the alternative hypothesis specifies that the location of group <em>%1$s</em> is greater than the location of group <em>%2$s</em>."
msgstr ""
"برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که مکان گروه <em>%1$s</em> بزرگ‌تر از "
"مکان گروه <em>%2$s</em> است."

msgid "For all tests, the alternative hypothesis specifies that the location of group <em>%1$s</em> is smaller than the location of group <em>%2$s</em>."
msgstr ""
"برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که مکان گروه <em>%1$s</em> کوچک‌تر از "
"مکان گروه <em>%2$s</em> است."

msgid "Bayesian Wilcoxon Signed-Rank Test"
msgstr "آزمون رتبه‌بندی علامت‌دار ویلکاکسون بیزی"

msgid "Bayesian One Sample T-Test"
msgstr "آزمون t تک‌نمونه‌ای بیزی"

msgid "For all tests, the alternative hypothesis specifies that the population mean is greater than %s."
msgstr ""
"برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که میانگین جامعه بزرگ‌تر از %s است."

msgid "For all tests, the alternative hypothesis specifies that the population mean is less than %s."
msgstr ""
"برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که میانگین جامعه کمتر از %s است."

msgid "For all tests, the alternative hypothesis specifies that the population mean differs from %s."
msgstr ""
"برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که میانگین جامعه با %s تفاوت دارد."

msgid "Bayesian Paired Samples T-Test"
msgstr "آزمون t نمونه‌های جفتی بیزی"

msgid "Measure 1"
msgstr "معیار ۱"

msgid "Measure 2"
msgstr "معیار ۲"

msgid "Independent Samples T-Test"
msgstr "آزمون t نمونه‌های مستقل"

msgid "Mann-Whitney U test."
msgstr "آزمون U مان-ویتنی."

msgid "U"
msgstr "U"

msgid "Welch's t-test."
msgstr "آزمون t ولچ."

msgid "t"
msgstr "t"

msgid "Student's t-test."
msgstr "آزمون t استیودنت."

msgid "Statistic"
msgstr "آماره"

msgid "Test"
msgstr "آزمون"

msgid "df"
msgstr "درجه آزادی"

msgid "p"
msgstr "p"

msgid "Cohen's d"
msgstr "d کوهن"

msgid "Glass' delta"
msgstr "دلتای گلس"

msgid "Hedges' g"
msgstr "g هجز"

msgid "Mean Difference"
msgstr "تفاوت میانگین"

msgid "Hodges-Lehmann Estimate"
msgstr "برآورد هاجز-لهمان"

msgid "Rank-Biserial Correlation"
msgstr "همبستگی رتبه-دووجهی"

msgid "Location Parameter"
msgstr "پارامتر مکان"

msgid "Effect Size"
msgstr "اندازه اثر"

msgid "Student t-test and Welch t-test"
msgstr "آزمون t استیودنت و آزمون t ولچ"

msgid "Student t-test"
msgstr "آزمون t استیودنت"

msgid "Welch t-test"
msgstr "آزمون t ولچ"

msgid "SE Difference"
msgstr "تفاوت خطای معیار"

msgid "For the %s, location parameter is given by mean difference. For the Mann-Whitney test, location parameter is given by the Hodges-Lehmann estimate."
msgstr ""
"برای %s، پارامتر مکان با تفاوت میانگین داده می‌شود. برای آزمون مان-ویتنی، "
"پارامتر مکان با برآورد هاجز-لهمان داده می‌شود."

msgid "%1$s%% CI for %2$s"
msgstr "بازه اطمینان %1$s%% برای %2$s"

msgid "SE %1$s"
msgstr "خطای معیار %1$s"

msgid "For the Mann-Whitney test, effect size is given by the rank biserial correlation."
msgstr "برای آزمون مان-ویتنی، اندازه اثر با همبستگی رتبه-دووجهی داده می‌شود."

msgid "For the %1$s, effect size is given by %2$s."
msgstr "برای %1$s، اندازه اثر با %2$s داده می‌شود."

msgid "Test of Normality (Shapiro-Wilk)"
msgstr "آزمون نرمال بودن (شاپیرو-ویلک)"

msgid "Residuals"
msgstr "باقی‌مانده‌ها"

msgid "W"
msgstr "W"

msgid "Significant results suggest a deviation from normality."
msgstr "نتایج معنادار نشان‌دهنده انحراف از نرمال بودن است."

msgid "Brown-Forsythe"
msgstr "براون-فورسایت"

msgid "Levene's"
msgstr "لوین"

msgid "Test of Equality of Variances (%1$s)"
msgstr "آزمون برابری واریانس‌ها (%1$s)"

msgid "F"
msgstr "F"

msgid "%s<sub>1</sub>"
msgstr "%s<sub>1</sub>"

msgid "%s<sub>2</sub>"
msgstr "%s<sub>2</sub>"

msgid "greater"
msgstr "بزرگ‌تر"

msgid "less"
msgstr "کمتر"

msgid "For all tests, the alternative hypothesis specifies that group %1$s is %2$s than group %3$s."
msgstr ""
"برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که گروه %1$s %2$s از گروه %3$s است."

msgid "Group 1: %1$s, Group 2: %2$s."
msgstr "گروه ۱: %1$s، گروه ۲: %2$s."

msgid "Brown-Forsythe test is significant (p < .05), suggesting a violation of the equal variance assumption"
msgstr ""
"آزمون براون-فورسایت معنادار است (p < .05)، که نشان‌دهنده نقض فرض برابری "
"واریانس‌ها است."

msgid "Levene's test is significant (p < .05), suggesting a violation of the equal variance assumption"
msgstr ""
"آزمون لوین معنادار است (p < .05)، که نشان‌دهنده نقض فرض برابری واریانس‌ها است."

msgid "Glass' delta uses the standard deviation of group %1$s of variable %2$s."
msgstr "دلتای گلس از انحراف معیار گروه %1$s متغیر %2$s استفاده می‌کند."

msgid "F-statistic could not be calculated"
msgstr "آماره F قابل محاسبه نبود"

msgid "Group Descriptives"
msgstr "آماره‌های توصیفی گروه"

msgid "Mean Rank"
msgstr "رتبه میانگین"

msgid "Sum Rank"
msgstr "مجموع رتبه‌ها"

msgid "One Sample T-Test"
msgstr "آزمون t تک‌نمونه‌ای"

msgid "Wilcoxon signed-rank test."
msgstr "آزمون رتبه‌بندی علامت‌دار ویلکاکسون."

msgid "V"
msgstr "V"

msgid "Z test."
msgstr "آزمون Z."

msgid "Z"
msgstr "Z"

msgid "Location Difference"
msgstr "تفاوت مکان"

msgid "Student t-test and Z-test"
msgstr "آزمون t استیودنت و آزمون Z"

msgid "Z-test"
msgstr "آزمون Z"

msgid "For the %s, location difference estimate is given by the sample mean difference <em>d</em>. For the Wilcoxon test, location difference estimate is given by the Hodges-Lehmann estimate."
msgstr ""
"برای %s، برآورد تفاوت مکان با تفاوت میانگین نمونه <em>d</em> داده می‌شود. "
"برای آزمون ویلکاکسون، برآورد تفاوت مکان با برآورد هاجز-لهمان داده می‌شود."

msgid "For the Student t-test, effect size is given by Cohen's <em>d</em>."
msgstr "برای آزمون t استیودنت، اندازه اثر با <em>d</em> کوهن داده می‌شود."

msgid "For the Wilcoxon test, effect size is given by the matched rank biserial correlation."
msgstr ""
"برای آزمون ویلکاکسون، اندازه اثر با همبستگی رتبه-دووجهی منطبق داده می‌شود."

msgid "For the Z test, effect size is given by Cohen's <em>d</em> (based on the provided population standard deviation)."
msgstr ""
"برای آزمون Z، اندازه اثر با <em>d</em> کوهن (بر اساس انحراف معیار جامعه "
"ارائه‌شده) داده می‌شود."

msgid "greater than"
msgstr "بزرگ‌تر از"

msgid "less than"
msgstr "کمتر از"

msgid "different from"
msgstr "متفاوت از"

msgid "For the %1$s, the alternative hypothesis specifies that the mean is %2$s %3$s."
msgstr "برای %1$s، فرض مقابل مشخص می‌کند که میانگین %2$s %3$s است."

msgid "For the Wilcoxon test, the alternative hypothesis specifies that the median is %1$s %2$s."
msgstr "برای آزمون ویلکاکسون، فرض مقابل مشخص می‌کند که میانه %1$s %2$s است."

msgid "CI could not be computed for effect size, due to low sample size and/or extreme effect size."
msgstr ""
"بازه اطمینان برای اندازه اثر به دلیل حجم نمونه کم و/یا اندازه اثر شدید قابل "
"محاسبه نبود."

msgid "Sample size too small for desired confidence level. Using %.1f%% instead"
msgstr ""
"حجم نمونه برای سطح اطمینان مطلوب بسیار کوچک است. به جای آن از %.1f%% استفاده "
"می‌شود."

msgid "Paired Samples T-Test"
msgstr "آزمون t نمونه‌های جفتی"

msgid "z"
msgstr "z"

msgid "For the Student t-test, location parameter is given by mean difference <em>d</em>. For the Wilcoxon test, location parameter is given by the Hodges-Lehmann estimate."
msgstr ""
"برای آزمون t استیودنت، پارامتر مکان با تفاوت میانگین <em>d</em> داده می‌شود. "
"برای آزمون ویلکاکسون، پارامتر مکان با برآورد هاجز-لهمان داده می‌شود."

msgid "For the Student t-test, effect size is given by Cohen's <em>d</em>. For the Wilcoxon test, effect size is given by the matched rank biserial correlation."
msgstr ""
"برای آزمون t استیودنت، اندازه اثر با <em>d</em> کوهن داده می‌شود. برای آزمون "
"ویلکاکسون، اندازه اثر با همبستگی رتبه-دووجهی منطبق داده می‌شود."

msgid "Cohen's d corrected for correlation between observations."
msgstr "d کوهن اصلاح‌شده برای همبستگی بین مشاهدات."

msgid "For all tests, the alternative hypothesis specifies that Measure 1 is less than Measure 2."
msgstr ""
"برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که معیار ۱ کمتر از معیار ۲ است."

msgid "For all tests, the alternative hypothesis specifies that Measure 1 is greater than Measure 2."
msgstr ""
"برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که معیار ۱ بزرگ‌تر از معیار ۲ است."

msgid "For all tests, the alternative hypothesis specifies that %1$s is less than %2$s."
msgstr "برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که %1$s کمتر از %2$s است."

msgid "For all tests, the alternative hypothesis specifies that %1$s is greater than %2$s."
msgstr "برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که %1$s بزرگ‌تر از %2$s است."

msgid "For all tests, the alternative hypothesis specifies that Measure 1 is less than Measure 2. For example, %1$s is less than %2$s."
msgstr ""
"برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که معیار ۱ کمتر از معیار ۲ است. به "
"عنوان مثال، %1$s کمتر از %2$s است."

msgid "For all tests, the alternative hypothesis specifies that Measure 1 is greater than Measure 2. For example, %1$s is greater than %2$s."
msgstr ""
"برای همه آزمون‌ها، فرض مقابل مشخص می‌کند که معیار ۱ بزرگ‌تر از معیار ۲ است. به "
"عنوان مثال، %1$s بزرگ‌تر از %2$s است."

msgid "The following pair is duplicated: %s"
msgid_plural "The following pairs are duplicated: %s"
msgstr[0] "جفت‌های زیر تکراری هستند: %s"
msgstr[1] "جفت‌های زیر تکراری هستند: %s"
